export native component WithBody {
    in property <int> limit;
    function start() { }
//                   > <error{Function declarations in a native component must not have a body}
}

export native component WithBinding {
    in property <int> a: 4;
//                       ><error{A native component cannot have bindings; set the value where you use it}
    in-out property <int> b <=> c;
//                          >    <error{A native component cannot have bindings; set the value where you use it}
    in-out property <int> c;
    property <int> d;
//  >               <error{'private' properties are inaccessible in a native component}
}

export native component WithContent {
    Rectangle { }
//  >           <error{A native component cannot have sub elements}
    callback init;
//  >            <error{A native component cannot have an 'init' callback}
}

export native component Finder { }

component Implements {
    implement Finder <=> self;
//            >     <error{Cannot implement Finder. It is not an interface}
}

export component Root inherits Window {
    Implements { }
}
