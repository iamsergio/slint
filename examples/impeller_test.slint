export component MainWindow inherits Window {
    width: 800px;
    height: 600px;
    background: #87CEEB;

    Rectangle {
        width: 400px;
        height: 300px;
        x: 200px;
        y: 150px;
        background: #FF4444;
        border-radius: 20px;
        border-width: 4px;
        border-color: #AA0000;

        transform-origin: { x: self.width / 2, y: self.height / 2 };
        // transform-rotation: animation-tick() * 1turn / 2s; // Continuous rotation


        Text {
            text: "Impeller Renderer Test";
            color: white;
            font-size: 32px;
        }
    }

    // Image test
    Image {
        source: @image-url("memory/icons/tile_logo.png");
        width: 128px;
        height: 128px;
        x: 20px;
        y: 20px;
        image-fit: contain;
    }

    // Linear gradient test
    Rectangle {
        width: 150px;
        height: 100px;
        x: 20px;
        y: 460px;
        background: @linear-gradient(135deg, #FF0000, #0000FF);
        border-radius: 10px;
    }

    // Radial gradient test
    Rectangle {
        width: 150px;
        height: 100px;
        x: 190px;
        y: 460px;
        background: @radial-gradient(circle, #FFFF00, #FF00FF);
        border-radius: 10px;
    }

    // Linear gradient with multiple stops
    Rectangle {
        width: 150px;
        height: 100px;
        x: 360px;
        y: 460px;
        background: @linear-gradient(90deg, #FF0000, #00FF00 50%, #0000FF);
        border-radius: 10px;
    }

    // Gradient border rectangle
    Rectangle {
        width: 150px;
        height: 100px;
        x: 530px;
        y: 460px;
        background: @linear-gradient(0deg, #00CED1, #FF6347);
        border-radius: 15px;
        border-width: 3px;
        border-color: #333333;
    }
}
