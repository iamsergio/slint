//ignore: cpp,rust,js,pyi,d.ts

native component Finder {
    in property <int> limit;
    in-out property <int> level;
    out property <int> found;
    callback finished(count: int);
    pure function add(a: int, b: int) -> int;
    function start();
}

export component TestCase {
    in property <int> limit: 7;
    in-out property <int> level;
    in-out property <int> level-changes;
    out property <bool> test: finder.limit == 7 && finder.found == 0 && finder.add(1, 2) == 0 && finder.level == level;

    Rectangle {
        finder := Finder {
            limit: root.limit;
            level <=> root.level;
            changed limit => { root.level-changes += 1; }
            finished(n) => { }
        }
        TouchArea {
            clicked => { finder.start(); }
        }
    }
}
