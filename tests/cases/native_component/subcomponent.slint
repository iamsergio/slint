//ignore: rust,js,pyi,d.ts,interpreter,cpp-live-preview,live-preview

native component Counter {
    in property <int> step;
    out property <int> value;
    function bump();
}

component Row {
    in property <int> step;
    out property <int> value: counter.value;
    public function bump() {
        counter.bump();
    }

    Rectangle {
        counter := Counter {
            step: root.step;
        }
    }
}

export component TestCase inherits Window {
    width: 100px;
    height: 100px;
    in property <[int]> steps;
    out property <int> first: first-row.value;
    out property <int> second: second-row.value;
    callback bump-first();
    callback bump-second();

    bump-first => {
        first-row.bump();
    }
    bump-second => {
        second-row.bump();
    }

    first-row := Row {
        step: 1;
    }
    second-row := Row {
        step: 10;
    }
    for step in steps: Row {
        step: step;
    }
}

