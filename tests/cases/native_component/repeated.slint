//ignore: rust,js,pyi,d.ts,interpreter,cpp-live-preview,live-preview

native component Finder {
    in property <int> limit;
    in-out property <int> shared;
    callback finished(count: int);
}

export component TestCase inherits Window {
    width: 100px;
    height: 100px;
    in property <[int]> limits;
    in-out property <int> total;
    in-out property <int> shared;

    for limit in limits: Rectangle {
        Finder {
            limit: limit;
            shared <=> root.shared;
            finished(n) => {
                root.total += n;
            }
        }
    }
}

/*
```cpp.toplevel
class FinderImpl : public Finder
{
public:
    static inline std::vector<FinderImpl *> all;
    static inline int destroyed = 0;

    FinderImpl() { all.push_back(this); }
    ~FinderImpl() override
    {
        destroyed++;
        all.erase(std::find(all.begin(), all.end(), this));
    }

    int seen_limit() const { return get_limit(); }
    void done(int n) const { invoke_finished(n); }
    int shared() const { return get_shared(); }
    void share(int n) const { set_shared(n); }
};

std::unique_ptr<Finder> Finder::create()
{
    return std::make_unique<FinderImpl>();
}
```

