```cpp.toplevel
class FinderImpl : public Finder
{
public:
    static inline FinderImpl *last = nullptr;
    static inline int alive = 0;

    FinderImpl()
    {
        last = this;
        alive++;
    }
    ~FinderImpl() override { alive--; }

    int add(int a, int b) override { return a + b; }
    void start() override
    {
        set_busy(true);
        set_found(get_limit() * 2);
        invoke_finished(get_limit());
        set_busy(false);
    }
    int seen_limit() const { return get_limit(); }
    void report(int n) const { set_found(n); }
};

std::unique_ptr<Finder> Finder::create()
{
    return std::make_unique<FinderImpl>();
}
```

