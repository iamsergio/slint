//ignore: rust,js,pyi,d.ts,interpreter,cpp-live-preview,live-preview

native component Finder {
    in property <int> limit;
    out property <int> found;
    out property <bool> busy;
    callback finished(count: int);
    pure function add(a: int, b: int) -> int;
    function start();
}

export component TestCase {
    in property <int> limit: 10;
    out property <int> found: finder.found;
    out property <bool> busy: finder.busy;
    out property <int> added: finder.add(2, 3);
    out property <string> last-message;
    callback begin();

    begin => {
        finder.start();
    }

    Rectangle {
        finder := Finder {
            limit: root.limit;
            finished(n) => {
                root.last-message = "done " + n;
            }
        }
    }
}

